# Copy this to .env.local:
#
#     cp .env.example .env.local
#
# Nothing here is secret. This app has no server, no API keys and no accounts.
# The one setting says which environment the build is for.

# local | production
#
# "local" turns on the import controls — the Import button, the folder picker,
# the empty-library dropzone and the drag-anywhere target. They write into
# whichever browser is looking at the page, so they belong on the machine that
# owns the audio files and nowhere else.
#
# Anything else, including unset, means production and hides them. `npm run
# deploy` sets it to production itself, so a deploy cannot pick this up from
# .env.local by accident.
NEXT_PUBLIC_ENV=local
