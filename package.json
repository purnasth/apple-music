{
  "name": "apple-music",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-songs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "songs": "node scripts/check-songs.mjs && node scripts/build-songs.mjs",
    "deploy": "npm run songs && npm run upload && npm run build && npx wrangler deploy",
    "postbuild": "rm -rf out/songs out/songs-art out/songs.json",
    "upload": "node scripts/upload-library.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "music-metadata": "^11.15.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
